{
  "name": "cyber-quiz-arena",
  "version": "1.0.0",
  "private": true,
  "description": "LAN-hosted Cyber Security Quiz Platform",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run backend\" \"npm run frontend\"",
    "frontend": "npm --prefix frontend run dev",
    "backend": "npm --prefix backend start",
    "start": "npm --prefix backend start",
    "seed": "npm --prefix backend run seed",
    "install:all": "npm --prefix backend install && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
